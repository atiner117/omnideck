.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust / Tauri build output
/src-tauri/target
/src-tauri/gen

# AUR build artifacts (makepkg / updpkgsums run in packaging/)
/packaging/*.tar.gz
/packaging/*.pkg.tar.zst
/packaging/src/
/packaging/pkg/

# icon rasterization intermediate (icon.svg is the source of truth)
/icon-source.png

# private engineering review + maintainer notes (not for the public repo)
/GLM-REVIEW.md
/NOTES.md
/NOTES-*.md
# …except the binding quality bars: CLAUDE.md holds every PR to these ("a regression
# there is not shippable"), so contributors and fresh clones must be able to read them.
!/NOTES-A11Y.md
!/NOTES-PERFORMANCE.md
!/NOTES-SECURITY.md
# maintainer-local agent instructions (tailnet-only infra; auto-loaded by Claude Code)
/CLAUDE.local.md

# ts-rs default export dir (every `cargo test` writes it; canonical copy: /src/lib/bindings)
/src-tauri/bindings/

# stray file-log dir from a mis-set XDG_STATE_HOME test run
src-tauri/omnideck/
