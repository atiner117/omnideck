pkgbase = omnideck
	pkgdesc = 10-foot, controller-first media & game launcher for Linux
	pkgver = 0.2.0
	pkgrel = 1
	url = https://github.com/atiner117/omnideck
	install = omnideck.install
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = rust
	makedepends = cargo
	makedepends = bun-bin
	makedepends = pkgconf
	depends = webkit2gtk-4.1
	depends = hicolor-icon-theme
	optdepends = gamescope: 10-foot gamescope session mode (run packaging/install-session.sh)
	optdepends = steam: Steam library scanning + launching
	optdepends = mpv: direct-play for the Jellyfin media library (4K hardware decode)
	optdepends = xorg-xprop: STEAM_GAME atom handling inside the gamescope session
	optdepends = cage: media-kiosk tier on hosts without a usable GPU
	options = !lto
	options = !debug
	source = omnideck-0.2.0.tar.gz::https://github.com/atiner117/omnideck/archive/refs/tags/v0.2.0.tar.gz
	b2sums = SKIP

pkgname = omnideck
